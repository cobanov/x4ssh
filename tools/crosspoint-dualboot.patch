@@ -393,6 +398,21 @@ void setup() {
   const bool recoveryFirmwareMode = wakeupReason == HalGPIO::WakeupReason::PowerButton && !BoardConfig::isPaperMono() &&
                                     mappedInputManager.isPressed(recoveryButton);
 
+  // x4ssh dual boot: Down + Power at wake boots x4ssh, and the note in NVS tells it to send a plain wake back
+  // here. getWakeupReason is PowerButton only for a real wake, so held buttons cannot bounce.
+  if (wakeupReason == HalGPIO::WakeupReason::PowerButton && gpio.isPressed(HalGPIO::BTN_DOWN)) {
+    const esp_partition_t* other = esp_ota_get_next_update_partition(nullptr);
+    esp_app_desc_t desc;
+    nvs_handle_t nvs;
+    if (other && esp_ota_get_partition_description(other, &desc) == ESP_OK && strstr(desc.project_name, "x4ssh") &&
+        nvs_open("x4ssh", NVS_READWRITE, &nvs) == ESP_OK) {
+      nvs_set_u8(nvs, "home", 1);
+      nvs_commit(nvs);
+      nvs_close(nvs);
+      if (ota_boot::switchTo(other)) esp_restart();
+    }
+  }
+
   halTiltSensor.begin();
   halClock.begin();
 
